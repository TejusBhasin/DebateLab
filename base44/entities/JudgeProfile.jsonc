{
  "name": "JudgeProfile",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string",
      "maxLength": 4000000
    },
    "projectId": {
      "type": "string",
      "maxLength": 4000000
    },
    "judgeName": {
      "type": "string",
      "maxLength": 4000000
    },
    "background": {
      "type": "string",
      "description": "Plain-text notes about the judge (school, paradigm, past rounds, preferences)"
    },
    "focus": {
      "type": "string",
      "description": "Optional instructions for how the contentions should be tailored"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 4000000
          },
          "label": {
            "type": "string",
            "maxLength": 4000000
          }
        }
      }
    },
    "judgeSummary": {
      "type": "string",
      "description": "What this judge rewards / what the tailoring assumes"
    },
    "tailoredContentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "side": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "warrant": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "sourceUrl": {
                  "type": "string"
                }
              }
            }
          },
          "possibleRebuttals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rebuttalResponses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "strategicNotes": {
            "type": "string"
          },
          "judgeFit": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready"
      ],
      "default": "pending"
    }
  },
  "required": [
    "projectId",
    "judgeName"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}